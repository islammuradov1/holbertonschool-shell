#!/usr/bin/env bash
# This script writes its PID to /var/run, handles signals, and loops forever

PIDFILE="/var/run/myscript.pid"

# Create PID file with sudo because /var/run/ is root-owned in Holberton checker
echo "$$" | sudo tee "$PIDFILE" >/dev/null

# Handle Ctrl+C
trap 'echo "Y U no love me?!";' INT

# Handle SIGTERM (kill)
trap 'echo "I hate the kill command"; sudo rm -f "$PIDFILE"; exit 0' TERM

# Handle SIGQUIT (cleanup and exit)
trap 'sudo rm -f "$PIDFILE"; exit 0' QUIT

while true
do
    echo "To infinity and beyond"
    sleep 1
done


echo $$ > /var/run/myscript.pid

