#!/usr/bin/env bash
# This script writes its PID to a file, handles signals and loops printing messages

PIDFILE="/var/run/myscript.pid"
echo "$$" | sudo tee "$PIDFILE" >/dev/null

# SIGINT → Ctrl+C
trap 'echo "Y U no love me?!";' INT

# SIGTERM → pkill / kill
trap 'echo "I hate the kill command";' TERM

# SIGQUIT or SIGTERM → cleanup + exit
cleanup() {
    sudo rm -f "$PIDFILE"
    exit 0
}
trap cleanup QUIT TERM

# Infinity loop
while true
do
    echo "To infinity and beyond"
    sleep 1
done

