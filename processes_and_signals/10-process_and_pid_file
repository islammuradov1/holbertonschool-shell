#!/usr/bin/env bash
# This script writes its PID, handles signals, and loops forever

PIDFILE="/var/run/myscript.pid"
echo "$$" > "$PIDFILE"

# SIGINT (Ctrl+C)
trap 'echo "Y U no love me?!";' INT

# SIGTERM → print message, then cleanup
trap 'echo "I hate the kill command"; rm -f "$PIDFILE"; exit 0' TERM

# SIGQUIT → cleanup and exit
trap 'rm -f "$PIDFILE"; exit 0' QUIT

while true
do
    echo "To infinity and beyond"
    sleep 1
done
