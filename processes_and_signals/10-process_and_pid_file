#!/usr/bin/env bash
# This script writes its PID, handles signals, and loops forever

PIDFILE="/var/run/myscript.pid"
echo "$$" > "$PIDFILE"

# SIGINT (Ctrl+C)
trap 'echo "Y U no love me?!";' INT

# SIGTERM (kill, pkill)
trap 'echo "I hate the kill command";' TERM

cleanup() {
    rm -f "$PIDFILE"
    exit 0
}

# Cleanup for SIGQUIT and SIGTERM
trap cleanup QUIT TERM

while true
do
    echo "To infinity and beyond"
    sleep 1
done
